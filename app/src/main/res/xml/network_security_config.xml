<?xml version="1.0" encoding="utf-8"?>
<!--
  Versión segura por defecto (build release): NO se permite tráfico en claro.
  La señalización debe usar wss:// (TLS). El cleartext ws:// solo se permite en
  builds de depuración (ver app/src/debug/res/xml/network_security_config.xml).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
