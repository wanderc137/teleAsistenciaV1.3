<?xml version="1.0" encoding="utf-8"?>
<!--
  Versión de DEPURACIÓN: permite tráfico en claro (cleartext ws://) solo para los
  hosts locales del servidor de señalización (red WiFi de desarrollo + emulador),
  manteniendo HTTPS/wss para el resto de destinos. En release NO se permite
  cleartext (ver app/src/main/res/xml/network_security_config.xml).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.0.2.60</domain>
        <domain includeSubdomains="true">192.0.2.200</domain>
        <domain includeSubdomains="true">192.0.2.201</domain>
        <domain includeSubdomains="true">192.0.2.80</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
