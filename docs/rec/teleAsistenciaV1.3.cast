[131.579, "o", "\u001b[90m 436\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00m\u001b[90m// Ciclo 11: NO resetear _peerOnline aquí. El estado \"En línea\" del par es\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[131.634, "o", "\u001b[90m 437\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00m\u001b[90m// independiente de la llamada; se gestiona con peer-online/peer-offline/\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
