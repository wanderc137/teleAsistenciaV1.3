[63.236, "o", "\u001b[90m┌─ server/index.js · enrutamiento a `to` ───────────────────────────────────────────────────────────────\u001b[0m\n"]
[63.236, "o", "\u001b[90m 176\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m// ---- Enrutamiento al destino `to` ----\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[63.291, "o", "\u001b[90m 177\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(to)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[63.346, "o", "\u001b[90m 178\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00mtargetSocket\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mclients.get(to);\u001b[90m\u001b[39;49;00m\n"]
[63.401, "o", "\u001b[90m 179\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(!targetSocket)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[63.456, "o", "\u001b[90m 180\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[90m// El destino no está conectado: si es una llamada y tiene token FCM,\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
