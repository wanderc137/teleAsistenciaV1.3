[130.974, "o", "\u001b[90m 425\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mprivate\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94mfun\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mcleanupCall\u001b[39;49;00m()\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[131.029, "o", "\u001b[90m 426\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[90m// F-002 (ciclo 5): guard idempotente. cleanupCall() puede llegar por varias vías\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[131.084, "o", "\u001b[90m 427\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[90m// (hangUp, onDisconnected, EndCall, CallRejected, PeerUnavailable); el compareAndSet\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[131.139, "o", "\u001b[90m 428\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[90m// garantiza que solo el primero ejecute el cleanup y los demás sean no-op.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[131.194, "o", "\u001b[90m 429\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(!cleaningUp.\u001b[96mcompareAndSet\u001b[39;49;00m(\u001b[94mfalse\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[94mtrue\u001b[39;49;00m))\u001b[90m \u001b[39;49;00m\u001b[94mreturn\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[131.249, "o", "\u001b[90m 430\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[94mtry\u001b[39;49;00m\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
