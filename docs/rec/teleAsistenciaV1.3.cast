[118.131, "o", "\u001b[90m┌─ WebRtcManager.kt · buildIceServers() ────────────────────────────────────────────────────────────────\u001b[0m\n"]
[118.131, "o", "\u001b[90m  47\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[94mfun\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mbuildIceServers\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[118.186, "o", "\u001b[90m  48\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00mturnUrl:\u001b[90m \u001b[39;49;00m\u001b[96mString?\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[118.241, "o", "\u001b[90m  49\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00mturnUsername:\u001b[90m \u001b[39;49;00m\u001b[96mString?\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[118.296, "o", "\u001b[90m  50\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00mturnPassword:\u001b[90m \u001b[39;49;00m\u001b[96mString?\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[118.351, "o", "\u001b[90m  51\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m):\u001b[90m \u001b[39;49;00mList<PeerConnection.\u001b[96mIceServer\u001b[39;49;00m>\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[118.406, "o", "\u001b[90m  52\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00m\u001b[94mval\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[91mservers\u001b[39;49;00m\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mmutableListOf(PeerConnection.\u001b[96mIceServer\u001b[39;49;00m(STUN_SERVER))\u001b[90m\u001b[39;49;00m\n"]
[118.461, "o", "\u001b[90m  53\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(!turnUrl.\u001b[96misNullOrBlank\u001b[39;49;00m())\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[118.516, "o", "\u001b[90m  54\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m                \u001b[39;49;00m\u001b[94mval\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[91musername\u001b[39;49;00m\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mturnUsername?.\u001b[96mtakeIf\u001b[39;49;00m\u001b[90m \u001b[39;49;00m{\u001b[90m \u001b[39;49;00m\u001b[96mit\u001b[39;49;00m.\u001b[96misNotBlank\u001b[39;49;00m()\u001b[90m \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[118.571, "o", "\u001b[90m  55\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m                \u001b[39;49;00m\u001b[94mval\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[91mpassword\u001b[39;49;00m\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mturnPassword?.\u001b[96mtakeIf\u001b[39;49;00m\u001b[90m \u001b[39;49;00m{\u001b[90m \u001b[39;49;00m\u001b[96mit\u001b[39;49;00m.\u001b[96misNotBlank\u001b[39;49;00m()\u001b[90m \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[118.626, "o", "\u001b[90m  56\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m                \u001b[39;49;00m\u001b[90m// Constructor posicional (compatible con todas las versiones de org.webrtc).\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[118.681, "o", "\u001b[90m  57\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m                \u001b[39;49;00m\u001b[94mval\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[91mturn\u001b[39;49;00m\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(username\u001b[90m \u001b[39;49;00m!=\u001b[90m \u001b[39;49;00m\u001b[94mnull\u001b[39;49;00m\u001b[90m \u001b[39;49;00m&&\u001b[90m \u001b[39;49;00mpassword\u001b[90m \u001b[39;49;00m!=\u001b[90m \u001b[39;49;00m\u001b[94mnull\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
